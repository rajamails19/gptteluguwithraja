VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Required for Sarvam read-aloud inside Capacitor Android.
# Use the deployed Vercel origin that serves /api/tts, without a trailing slash.
VITE_TTS_API_ORIGIN=https://your-vercel-domain.vercel.app

# Server-only. Set locally for website dev and in Vercel project settings.
SARVAM_API_KEY=
# Comma-separated additional origins allowed to call /api/tts.
# Same-origin web requests and Capacitor's standard local origins are allowed automatically.
TTS_ALLOWED_ORIGINS=https://your-custom-domain.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
